# Copy to .env.local and fill in. Never commit .env.local.
# For the live site each setting also goes where its comment says (Vercel: Project → Settings → Environment
# Variables, Production). The deploy checks them: scripts/check-deploy-env.mjs.

# Supabase → "Connect" → "App Frameworks" → Next.js. Public (safe in the browser).
# Vercel type: Config (the build reads them)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret keys. Server only: creates accounts, changes access.
# Vercel type: Secret
SUPABASE_SECRET_KEY=

# Supabase → "Connect" → "ORMs" → Prisma, with your database password filled in.
# App queries, transaction pooler (port 6543). Vercel type: Secret
DATABASE_URL=
# Migrations, session pooler (port 5432). Not in Vercel: a GitHub Actions secret (repository Settings →
# Secrets and variables → Actions), used only by the deploy's migration step.
DIRECT_URL=

# Accounts with these emails become admins when they register (comma-separated). Vercel type: Secret or Config
ADMIN_EMAILS=
