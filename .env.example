# Copy to .env.local and fill in. Never commit .env.local.
# Vercel needs the same variables (Project → Settings → Environment Variables, Production; not "Sensitive").

# Supabase → "Connect" → "App Frameworks" → Next.js (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret keys (server only: creates accounts, changes access)
SUPABASE_SECRET_KEY=

# Supabase → "Connect" → "ORMs" → Prisma, with your database password filled in
# App queries: transaction pooler (port 6543)
DATABASE_URL=
# Migrations: session pooler (port 5432)
DIRECT_URL=

# Accounts with these emails become admins when they register (comma-separated)
ADMIN_EMAILS=
