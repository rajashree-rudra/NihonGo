{
  "name": "nihongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "data:strokes": "node --experimental-strip-types --no-warnings scripts/fetch-strokes.mjs",
    "data:parts": "node --experimental-strip-types --no-warnings scripts/fetch-parts.mjs",
    "data:audio": "node --experimental-strip-types --no-warnings scripts/generate-audio.mjs",
    "data:audio:male": "node --experimental-strip-types --no-warnings scripts/generate-audio.mjs --voice=male",
    "data:vocab-art": "node scripts/list-vocab-art.mjs",
    "data:glosses": "node --experimental-strip-types --no-warnings scripts/check-glosses.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "svg-path-properties": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
